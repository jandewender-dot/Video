{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "SharePoint-Link im Standardbrowser öffnen; Windows-Dialoge zum Speichern und Öffnen",
  "windows": ["main"],
  "permissions": [
    "dialog:allow-save",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://symriseag.sharepoint.com/*" }]
    }
  ]
}
