{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ASI-Dashboard",
  "version": "2.7.0",
  "identifier": "de.symsafe.asi-dashboard",
  "build": { "frontendDist": "web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Maßnahmen- & Fristendashboard – Arbeitsschutz · ASI",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] }
}
